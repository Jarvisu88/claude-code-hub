# Claude Code Hub - Environment Variables
# Copy to .env and customize before deployment.

# ---- Admin ----
ADMIN_TOKEN=change-me

# ---- Database (used by docker-compose) ----
DB_USER=postgres
DB_PASSWORD=your-secure-password_change-me
DB_NAME=claude_code_hub

# ---- Application ----
AUTO_MIGRATE=true
APP_PORT=23000
LOG_LEVEL=info
TZ=Asia/Shanghai

# ---- Rate limiting / Redis ----
ENABLE_RATE_LIMIT=true
SESSION_TTL=300
